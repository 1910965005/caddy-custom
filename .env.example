# Copy to .env on your VPS. Fill in the first three values before starting.
DOMAIN=caddy.example.com
ACME_EMAIL=admin@example.com
CF_API_TOKEN=

CADDY_IMAGE=ghcr.io/1910965005/caddy-custom:latest

# Optional: used only after enabling config/layer4.caddy + compose.l4.yaml.
# Replace these example private-network addresses with reachable backends.
L4_TCP_UPSTREAM=10.0.0.10:5432
L4_UDP_UPSTREAM=10.0.0.10:51820
L4_TCP_PORT=15432
L4_UDP_PORT=15182
# Use 0.0.0.0 when you intend external clients to connect to the L4 ports.
L4_BIND_ADDRESS=127.0.0.1
