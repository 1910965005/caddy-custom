{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}

	# Optional L4: copy layer4.caddy.example to layer4.caddy, then uncomment.
	# import /etc/caddy/layer4.caddy
}

{$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	encode zstd gzip
	respond "Caddy custom is running.\n" 200
	log

	# For an HTTP application, replace respond above with reverse_proxy:
	# reverse_proxy host.docker.internal:8080
	# Or use a service name on the same Docker network, e.g. app:8080.
}
